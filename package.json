{
  "name": "bloli-nearby",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env.local --import tsx --watch src/server/main.ts",
    "build": "tsc --noEmit && vite build && node scripts/build-site-shells.mjs",
    "start": "tsx src/server/main.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "import": "tsx src/server/import-cli.ts",
    "migrate": "tsx src/server/migrate-cli.ts",
    "debug:api": "node --env-file=.env.local --inspect=127.0.0.1:9229 --import tsx --watch src/server/main.ts",
    "seed:sample": "node --env-file-if-exists=.env.local --import tsx scripts/seed-sample.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.61.0",
    "opening_hours": "3.15.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.19.15",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "description": "One shared OpenStreetMap platform for nearby places: Find a Loo and Kippe."
}
