# Development only: Docker PostGIS; API and frontend run on the host.
DEV_DB_PORT=55432
DEV_DB_USER=bloli_dev
DEV_DB_NAME=bloli_nearby_dev
DEV_DB_VOLUME=bloli-nearby-dev-postgres-data
DEV_DB_PASSWORD=bloli-dev-only
DATABASE_URL=postgres://bloli_nearby_dev:bloli-dev-only@127.0.0.1:55432/bloli_nearby_dev
PORT=3100
HOST=127.0.0.1
CONTACT_EMAIL=
MIN_FACILITIES=1
MIN_SETTLEMENTS=1
MIN_IMPORT_RATIO=0.75

MIN_SELLERS=1

MIN_KEBABS=1

# Independent Water bootstrap floor; sample seed sets this to 1.
MIN_WATER_POINTS=100

# Independent Transit bootstrap floor; sample seed sets this to1.
MIN_TRANSIT_STOPS=1000

# Charge station publication minimum
MIN_CHARGE_STATIONS=100

# View and Sights floors: set after measure-only counts for each country.
MIN_DE_VIEWPOINTS=
MIN_DE_VENDING_MACHINES=
MIN_DE_SIGHTS=
MIN_RO_VIEWPOINTS=
MIN_RO_VENDING_MACHINES=
MIN_RO_SIGHTS=
MIN_AT_VIEWPOINTS=
MIN_AT_VENDING_MACHINES=
MIN_AT_SIGHTS=
MIN_HU_VIEWPOINTS=
MIN_HU_VENDING_MACHINES=
MIN_HU_SIGHTS=
