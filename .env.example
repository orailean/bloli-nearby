WEB_PORT=8088
# Set your real contact address before publishing the app.
CONTACT_EMAIL=
DB_PASSWORD_FILE=./.secrets/db_password
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION=© OpenStreetMap contributors
TILE_MAX_ZOOM=19
DATA_URL=https://download.geofabrik.de/europe/germany-latest.osm.pbf
POLY_URL=https://download.geofabrik.de/europe/germany.poly
MIN_FACILITIES=1000
MIN_SETTLEMENTS=1000
MIN_IMPORT_RATIO=0.75

MIN_SELLERS=100

DB_USER=bloli
DB_NAME=bloli_nearby

MIN_KEBABS=100
# Production override uses existing, explicitly created external volumes.
POSTGRES_VOLUME=bloli-nearby_postgres_data
IMPORT_VOLUME=bloli-nearby_import_data

# Independent Water bootstrap floor; sample seed sets this to 1.
MIN_WATER_POINTS=100
