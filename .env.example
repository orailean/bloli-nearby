WEB_PORT=8088
# Set your real contact address before publishing the app.
CONTACT_EMAIL=
DB_PASSWORD_FILE=./.secrets/db_password
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION=© OpenStreetMap contributors
TILE_MAX_ZOOM=19
DATA_URL=https://download.geofabrik.de/europe/germany-latest.osm.pbf
POLY_URL=https://download.geofabrik.de/europe/germany.poly
MIN_FACILITIES=1000
MIN_SETTLEMENTS=1000
MIN_IMPORT_RATIO=0.75

MIN_SELLERS=100

DB_USER=bloli
DB_NAME=bloli_nearby

MIN_KEBABS=100
# Production override uses existing, explicitly created external volumes.
POSTGRES_VOLUME=bloli-nearby_postgres_data
IMPORT_VOLUME=bloli-nearby_import_data

# Independent Water bootstrap floor; sample seed sets this to 1.
MIN_WATER_POINTS=100

# Independent Transit bootstrap floor; sample seed sets this to1.
MIN_TRANSIT_STOPS=1000

# Charge station publication minimum
MIN_CHARGE_STATIONS=100

# Set independently after measuring each country's first complete six-category import.
MIN_RO_TOILETS=
MIN_RO_SELLERS=
MIN_RO_KEBABS=
MIN_RO_WATER_POINTS=
MIN_RO_TRANSIT_STOPS=
MIN_RO_CHARGE_STATIONS=
MIN_RO_SETTLEMENTS=
MIN_AT_TOILETS=
MIN_AT_SELLERS=
MIN_AT_KEBABS=
MIN_AT_WATER_POINTS=
MIN_AT_TRANSIT_STOPS=
MIN_AT_CHARGE_STATIONS=
MIN_AT_SETTLEMENTS=
MIN_HU_TOILETS=
MIN_HU_SELLERS=
MIN_HU_KEBABS=
MIN_HU_WATER_POINTS=
MIN_HU_TRANSIT_STOPS=
MIN_HU_CHARGE_STATIONS=
MIN_HU_SETTLEMENTS=

# ATM and accommodation minima: set independently after measure-only validation.
MIN_DE_ATMS=
MIN_DE_ACCOMMODATIONS=
MIN_RO_ATMS=
MIN_RO_ACCOMMODATIONS=
MIN_AT_ATMS=
MIN_AT_ACCOMMODATIONS=
MIN_HU_ATMS=
MIN_HU_ACCOMMODATIONS=

# View and Sights floors: set after measure-only counts for each country.
MIN_DE_VIEWPOINTS=
MIN_DE_SIGHTS=
MIN_RO_VIEWPOINTS=
MIN_RO_SIGHTS=
MIN_AT_VIEWPOINTS=
MIN_AT_SIGHTS=
MIN_HU_VIEWPOINTS=
MIN_HU_SIGHTS=
