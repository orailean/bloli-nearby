[Unit]
Description=Refresh active country location and settlement snapshots for Bloli Nearby
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=oliver
WorkingDirectory=/home/oliver/stack/bloli-nearby
ExecStart=/home/oliver/stack/bloli-nearby/scripts/update.sh
TimeoutStartSec=6h
Nice=10
UMask=0077
