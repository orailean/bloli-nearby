{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Grafana Cloud Logs",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "loki",
      "name": "Loki",
      "version": "1.0.0"
    }
  ],
  "title": "Bloli Nearby operations",
  "uid": "bloli-nearby-ops",
  "version": 1,
  "schemaVersion": 39,
  "editable": true,
  "tags": [
    "bloli-nearby"
  ],
  "timezone": "utc",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "",
  "description": "Versioned in deploy/log-collector/dashboard.json; import manually. Labels: app, env, service. Event fields (country, site, jobId, revision) are parsed at query time.",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "api,web,db,refresh,backup,deploy",
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "api",
            "value": "api",
            "selected": false
          },
          {
            "text": "web",
            "value": "web",
            "selected": false
          },
          {
            "text": "db",
            "value": "db",
            "selected": false
          },
          {
            "text": "refresh",
            "value": "refresh",
            "selected": false
          },
          {
            "text": "backup",
            "value": "backup",
            "selected": false
          },
          {
            "text": "deploy",
            "value": "deploy",
            "selected": false
          }
        ]
      },
      {
        "name": "country",
        "label": "Country",
        "type": "custom",
        "query": "de,ro,at,hu",
        "includeAll": true,
        "multi": true,
        "allValue": "[a-z]{2}",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "de",
            "value": "de",
            "selected": false
          },
          {
            "text": "ro",
            "value": "ro",
            "selected": false
          },
          {
            "text": "at",
            "value": "at",
            "selected": false
          },
          {
            "text": "hu",
            "value": "hu",
            "selected": false
          }
        ]
      },
      {
        "name": "revision",
        "label": "Revision prefix",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API errors",
      "description": "Unexpected API failures (HTTP 503) in the selected time range.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum(count_over_time({app=\"bloli-nearby\", service=\"api\"} |= \"api_operation_failed\" [$__range]))",
          "queryType": "instant",
          "legendFormat": "{{country}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Country refreshes OK (8 days)",
      "description": "Weekly timer: every active country should show at least 1. A missing country did not succeed in the last 8 days.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum by (country) (count_over_time({app=\"bloli-nearby\", service=\"refresh\"} |~ \"\\\\[refresh\\\\] country=[a-z]+ result=success\" | regexp \"country=(?P<country>[a-z]+)\" [8d]))",
          "queryType": "instant",
          "legendFormat": "{{country}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Refresh failures (8 days)",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum(count_over_time({app=\"bloli-nearby\", service=\"refresh\"} |~ \"\\\\[refresh\\\\] country=[a-z]+ result=failed\" [8d]))",
          "queryType": "instant",
          "legendFormat": "{{country}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Backups OK (8 days)",
      "description": "Daily timer: expect 7 (or more with deployment backups).",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 14,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum(count_over_time({app=\"bloli-nearby\", service=\"backup\"} |= \"[backup] result=success\" [8d]))",
          "queryType": "instant",
          "legendFormat": "{{country}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 6
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Backup failures (8 days)",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 17,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum(count_over_time({app=\"bloli-nearby\", service=\"backup\"} |= \"[backup] result=failed\" [8d]))",
          "queryType": "instant",
          "legendFormat": "{{country}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Ingested (24 h)",
      "description": "Free plan: 50 GB/month, about 1.6 GB/day. The collector caps at 50 lines/s.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum(bytes_over_time({app=\"bloli-nearby\"}[24h]))",
          "queryType": "instant",
          "legendFormat": "{{country}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1300000000.0
              },
              {
                "color": "red",
                "value": 1600000000.0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Deploy failures (14 days)",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum(count_over_time({app=\"bloli-nearby\", service=\"deploy\"} |= \"result=failed\" [14d]))",
          "queryType": "instant",
          "legendFormat": "{{country}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Successful deploys (14 days)",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 4,
        "y": 4,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum(count_over_time({app=\"bloli-nearby\", service=\"deploy\"} |= \"command=finalize\" |= \"result=success\" [14d]))",
          "queryType": "instant",
          "legendFormat": "{{country}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "textMode": "value"
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "API errors by site",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 16,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum by (site) (count_over_time({app=\"bloli-nearby\", service=\"api\"} |= \"api_operation_failed\" | json site [$__auto]))",
          "legendFormat": "{{site}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right"
        }
      }
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Errors and failures",
      "description": "Filter by service, revision prefix and free text with the variables above.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "{app=\"bloli-nearby\", service=~\"${service:regex}\"} |~ \"(?i)error|failed|fatal|panic|exception|deadlock|traceback\" |~ \"${revision}\" |~ \"${search}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Country imports",
      "description": "Per-country start/finish events (job, duration, counts, sanitized error) and refresh wrapper outcomes.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "{app=\"bloli-nearby\", service=\"refresh\"} |~ \"\\\"event\\\":\\\"import_|\\\\[refresh\\\\]|\\\\[source\\\\]|\\\\[publish\\\\]\" |~ \"(\\\"country\\\":\\\"|country=|countries=)${country:regex}|\\\\[(source|publish|filter)\\\\]\" |~ \"${revision}\" |~ \"${search}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Import outcomes",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "{app=\"bloli-nearby\", service=\"refresh\"} |= \"\\\"event\\\":\\\"import_finished\\\"\" | json | country=~\"${country:regex}\" | line_format \"{{.country}} {{.status}} in {{.durationMs}} ms, job {{.jobId}}, revision {{.revision}} {{.error_code}}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
    {
      "id": 13,
      "type": "logs",
      "title": "Backups and deployments",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "{app=\"bloli-nearby\", service=~\"backup|deploy\"} |~ \"\\\\[(backup|deploy)\\\\]\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
    {
      "id": 14,
      "type": "logs",
      "title": "API releases and schema migrations",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "{app=\"bloli-nearby\", service=\"api\"} |~ \"\\\"event\\\":\\\"(api_started|schema_migration)\" |~ \"${revision}\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    }
  ]
}
