#!/bin/sh
set -eu

# Scope this new hook to the app certificates, leaving other lineages alone.
case " ${RENEWED_DOMAINS:-} " in
    *" loo.bloli.com "*|*" kippe.bloli.com "*|*" kebab.bloli.com "*|*" water.bloli.com "*|*" transit.bloli.com "*|*" charge.bloli.com "*) ;;
    *) exit 0 ;;
esac

/usr/bin/docker exec nginx nginx -t
/usr/bin/docker exec nginx nginx -s reload
